DATABASE_URL="mysql://landnest_app:landnest_dev_pass@localhost:3306/landnest"
SESSION_SECRET="replace-with-a-64-char-cryptographically-random-hex-secret"
NODE_ENV="development"
PORT=5000
FRONTEND_URL="http://localhost:5173"

S3_ENDPOINT="http://localhost:9000"
