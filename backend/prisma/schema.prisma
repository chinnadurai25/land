generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PropertyType {
  LAND_PLOT
  AGRI_LAND
  RESIDENTIAL_HOME
  APARTMENT
  COMMERCIAL_SPACE
}

enum ListingPurpose {
  SALE
  RENT
}

enum RentPeriod {
  MONTHLY
  YEARLY
}

enum FacingDirection {
  NORTH
  SOUTH
  EAST
  WEST
  NORTH_EAST
  NORTH_WEST
  SOUTH_EAST
  SOUTH_WEST
}

enum ApprovalStatus {
  NOT_PROVIDED
  PENDING_VERIFICATION
  VERIFIED
}

enum PublicationStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum ImageCategory {
  SITE_PHOTO
  LAYOUT
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                String          @id @default(cuid())
  fullName          String
  email             String          @unique
  passwordHash      String
  phone             String
  role              Role            @default(USER)
  accountStatus     AccountStatus   @default(PENDING)
  accountReviewNote String?         @db.Text
  lastLoginAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  sessions     Session[]
  properties   Property[]
  inquiries    Inquiry[]
  favorites    Favorite[]
  auditLogs    AdminAuditLog[]

  @@index([accountStatus, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Location {
  id         String     @id @default(cuid())
  locality   String
  city       String     @default("Madurai")
  state      String     @default("Tamil Nadu")
  postalCode String?
  latitude   Decimal?   @db.Decimal(10, 7)
  longitude  Decimal?   @db.Decimal(10, 7)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  properties Property[]

  @@unique([locality, city])
  @@index([locality])
}

model Property {
  id                String            @id @default(cuid())
  ownerId           String
  locationId        String
  title             String
  slug              String            @unique
  description       String            @db.Text
  propertyType      PropertyType
  listingPurpose    ListingPurpose
  price             Decimal           @db.Decimal(14, 2)
  rentPeriod        RentPeriod?
  totalAreaSqFt     Int
  facingDirection   FacingDirection
  roadWidth         String
  approvalStatus    ApprovalStatus    @default(NOT_PROVIDED)
  approvalReference String?
  landmark          String
  publicationStatus PublicationStatus @default(DRAFT)
  isFeatured        Boolean           @default(false)
  isDemo            Boolean           @default(false)
  adminReviewNote   String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  publishedAt       DateTime?

  owner             User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  location          Location          @relation(fields: [locationId], references: [id])
  images            PropertyImage[]
  inquiries         Inquiry[]
  favorites         Favorite[]

  @@index([publicationStatus, listingPurpose, propertyType])
  @@index([publicationStatus, isFeatured])
  @@index([locationId])
  @@index([ownerId])
  @@index([price])
  @@index([createdAt])
}

model PropertyImage {
  id           String        @id @default(cuid())
  propertyId   String
  storageKey   String
  imageUrl     String        @db.VarChar(1024)
  thumbnailUrl String?       @db.VarChar(1024)
  altText      String
  category     ImageCategory @default(SITE_PHOTO)
  displayOrder Int           @default(0)
  isCover      Boolean       @default(false)
  createdAt    DateTime      @default(now())

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, displayOrder])
}

model Inquiry {
  id           String        @id @default(cuid())
  propertyId   String?
  userId       String?
  name         String
  email        String
  phone        String
  propertyType String
  message      String        @db.Text
  status       InquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  property     Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([propertyId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
}

model CaptchaChallenge {
  id         String    @id @default(cuid())
  answerHash String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}
