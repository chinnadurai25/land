# Database (MySQL 8+)
DATABASE_URL="mysql://landnest:landnest_dev_password@localhost:3306/landnest"

# Application & Security
NODE_ENV="development"
PORT=5000
FRONTEND_URL="http://localhost:5173"
SESSION_SECRET="replace-with-a-64-char-random-secret-string"
CAPTCHA_SECRET="replace-with-another-64-char-random-secret-string"

# Media Storage (S3-compatible object storage)
# In development only, set STORAGE_DRIVER="local" if S3/MinIO is not running.
# In production, S3_* must be configured and STORAGE_DRIVER="s3".
STORAGE_DRIVER="s3"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-south-1"
S3_BUCKET="landnest-media"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_BASE_URL="http://localhost:9000/landnest-media"

# Upload limits
MAX_UPLOAD_FILE_SIZE_MB=5
MAX_IMAGES_PER_PROPERTY=10

# Admin bootstrap credentials (used only by npm run admin:bootstrap)
ADMIN_BOOTSTRAP_NAME="Landnest Administrator"
ADMIN_BOOTSTRAP_EMAIL="admin@landnest.in"
ADMIN_BOOTSTRAP_PASSWORD="ChangeMeToAStrongPassword123!"
ADMIN_BOOTSTRAP_PHONE="+91 98421 00001"

# Frontend API URL (Vite)
VITE_API_BASE_URL="http://localhost:5000/api/v1"
